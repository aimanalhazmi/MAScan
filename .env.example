# MAScan — Environment Variables
# Copy this file to `.env` and fill in your values.

#  LLM Provider
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL_DEFAULT=gpt-4o-mini

#  RAG store (PGVector). Leave unset to disable RAG (NullRetriever).
#  In docker-compose the host is `postgres`; for local runs use `localhost`.
DATABASE_URL=postgresql+psycopg://mascan:mascan@postgres:5432/mascan
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RAG_COLLECTION=mascan
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_IMAGE_DIR=rag_images
#  Self-correction (CRAG) rewrite-retries on the full retrieval path.
RAG_MAX_RETRIES=1

#  Vision model — reads & captions PDF figures at ingest and answer time.
#  Defaults to OpenAI gpt-4o. To cut cost on image-heavy ingests, point at a
#  self-hosted OpenAI-compatible endpoint (Ollama, Groq ...):
#  e.g. `ollama pull qwen2.5-vl`, then VISION_BASE_URL=http://localhost:11434/v1
#  and RAG_VISION_MODEL=qwen2.5-vl. Leave VISION_* blank to use OpenAI.
RAG_VISION_MODEL=gpt-4o
VISION_BASE_URL=
VISION_API_KEY=

# Web search API (Firecrawl).
# Cloud: set FIRECRAWL_API_KEY
# Or Self-hosted: leave the key blank and set FIRECRAWL_API_URL.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=http://firecrawl:3002

# NEWS_API_KEY from https://newsdata.io
NEWS_API_KEY=

# Patent APIs
# EPO Open Patent Services (OPS) API key: (register at https://developers.epo.org/user/register)
# They need time to approve your account, so you may need to wait a few days.
# We won't be using this for now due to the verification delay, but you can still set it up for future use.
EPO_OPS_API_KEY=

# Semantic Scholar API key: (register at https://www.semanticscholar.org/product/api#api-key-form)
# Also needs time to approve your account, so you may need to wait a few days.
# For me it took 20 minutes to get approved.
# We won't be using the api key for now due to the verification delay, but you can still set it up for future use.
# However we are using the API URL so make sure to copy this to your .env file.
# The API Key is optional providing one improves the rate limit and access to some endpoints. If you don't have one, you can leave it blank.
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1

# Agent Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="mascan-dev"

# Application
LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR


# Reddit: run `rdt login` once. It caches a session to ~/.config/rdt-cli/credential.json
# the tool then reuses the cached session non-interactively.
#
# X/Twitter: paste the auth_token and ct0 cookies from a logged-in x.com browser session
# (DevTools → Application → Cookies → https://x.com).
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
