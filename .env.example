# MAScan — Environment Variables
# Copy this file to `.env` and fill in your values.

#  LLM Provider
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL_DEFAULT=gpt-4o-mini

# Gold-standard evaluation judge model.
EVAL_JUDGE_MODEL=gpt-4o

# Web search API (Firecrawl).
# Cloud (recommended for local eval on Windows): set FIRECRAWL_API_KEY and leave
# FIRECRAWL_API_URL empty or commented out.
# Self-hosted via Docker Compose: set FIRECRAWL_API_URL=http://localhost:3002
# (not http://firecrawl:3002 — that hostname only works inside the compose network).
FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=http://localhost:3002

# NEWS_API_KEY from https://newsdata.io
NEWS_API_KEY=

# Agent Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="mascan-dev"

# Application
LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR


# Reddit: run `rdt login` once. It caches a session to ~/.config/rdt-cli/credential.json
# the tool then reuses the cached session non-interactively.
#
# X/Twitter: paste the auth_token and ct0 cookies from a logged-in x.com browser session
# (DevTools → Application → Cookies → https://x.com).
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
