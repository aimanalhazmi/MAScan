# MAScan — Environment Variables
# Copy this file to `.env` and fill in your values.

#  LLM Provider
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL_DEFAULT=gpt-4o-mini

# Web search API
FIRECRAWL_API_KEY=fc-your-firecrawl-key-here

# NEWS_API_KEY from https://newsdata.io
NEWS_API_KEY=

# Agent Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=lsv2-......
LANGSMITH_PROJECT="mascan-dev"

# Application
LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR

# Agent-specific external APIs
# add your agent's API keys here AND document them.

