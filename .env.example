# MAScan — Environment Variables
# Copy this file to `.env` and fill in your values.

#  LLM Provider
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL_DEFAULT=gpt-4o-mini

# Web search API
FIRECRAWL_API_KEY=fc-your-firecrawl-key-here

# NEWS_API_KEY from https://newsdata.io
NEWS_API_KEY=

# Agent Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="mascan-dev"

# Application
LOG_LEVEL=INFO            # DEBUG, INFO, WARNING, ERROR

# Optional local social-media CLI tools
# Requires `uv tool install twitter-cli` and `uv tool install rdt-cli`.
# Set these to false to skip X/Reddit searches.
# When enabled, open your local browser first and confirm X/Reddit are logged in.
# You can usually check the local CLI login state with `twitter status` and `rdt status`.
# The CLI tools may ask for your macOS password to access browser cookies/keychain.
SOCIAL_ENABLE_X=true
SOCIAL_ENABLE_REDDIT=true
TWITTER_CLI_COMMAND=twitter
REDDIT_CLI_COMMAND=rdt
